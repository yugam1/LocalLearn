# Copy this to `.env` and adjust per machine.  `.env` is gitignored (machine-specific).
#
#   cp .env.example .env
#
# On the ASUS (server itself), localhost is correct:
OLLAMA_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333
#
# On the Mac (dev client), point at the ASUS instead:
#   OLLAMA_URL=http://192.168.1.19:11434
#   QDRANT_URL=http://192.168.1.19:6333
